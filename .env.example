# Sao chép thành .env (cùng thư mục) rồi chỉnh. Đường dẫn tương đối tính từ thư mục backend/.

# ---- API ----
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Cơ sở dữ liệu ----
# Để trống = SQLite tại database/ecoai.db
DATABASE_URL=
# PostgreSQL: DATABASE_URL=postgresql+psycopg2://ecoai:matkhau@localhost:5432/ecoai  (pip install psycopg2-binary)

# ---- Upload ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
MAX_IMAGE_SIDE=1920
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
SAVE_HISTORY=true

# ---- Thiết bị ----
# auto: dùng GPU CUDA nếu có, ngược lại CPU | cuda | cuda:0 | cpu
DEVICE=auto
HALF_PRECISION=true

# ---- YOLO (phát hiện + phân loại) ----
YOLO_WEIGHTS=ai/weights/yolo/ecoai-waste.pt
YOLO_CONF=0.35
YOLO_IOU=0.45
YOLO_IMGSZ=640
YOLO_MAX_DET=50
CLASS_MAP=ai/yolo/class_map.yaml

# ---- SAM (phân đoạn) ----
SAM_ENABLED=true
# ultralytics: SAM / SAM 2 / SAM 2.1 qua Ultralytics (khuyên dùng)
# sam2       : thư viện gốc facebookresearch/sam2 (cần SAM2_CONFIG)
SAM_BACKEND=ultralytics
SAM_WEIGHTS=ai/weights/sam/sam2.1_b.pt
SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_b+.yaml
